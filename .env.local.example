# Copy to .env.local to enable Google sign-in and Firestore on /workspace.
# See README.md for setup and security rules. /demo always stays public.
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Server only. OPEN_AI_API_KEY is also supported for existing configurations.
OPENAI_API_KEY=your-openai-api-key
OPENAI_SUPPORT_MODEL=gpt-4.1-mini
# Optional; falls back to OPENAI_SUPPORT_MODEL. Used by /api/draft for the demo appeal letter.
OPENAI_DRAFT_MODEL=gpt-4.1-mini
